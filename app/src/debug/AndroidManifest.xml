<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
            Debug builds only. Lets on-device test scripts drive the agent over adb
            (register against a mock backend, simulate an FCM wake, use a virtual printer).
            Guarded by DUMP, which only the adb shell holds; absent from release builds.
        -->
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.sopifo.printagent.debug.COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
