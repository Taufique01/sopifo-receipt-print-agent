# kotlinx.serialization
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.**
-keepclassmembers class kotlinx.serialization.json.** { *** Companion; }
-keepclasseswithmembers class kotlinx.serialization.json.** { kotlinx.serialization.KSerializer serializer(...); }
-keep,includedescriptorclasses class com.sopifo.printagent.**$$serializer { *; }
-keepclassmembers class com.sopifo.printagent.** {
    *** Companion;
}
-keepclasseswithmembers class com.sopifo.printagent.** {
    kotlinx.serialization.KSerializer serializer(...);
}

# Workers are instantiated reflectively by WorkManager
-keep class * extends androidx.work.ListenableWorker { <init>(...); }

# OkHttp
-dontwarn okhttp3.internal.platform.**
-dontwarn org.conscrypt.**
-dontwarn org.bouncycastle.**
-dontwarn org.openjsse.**
